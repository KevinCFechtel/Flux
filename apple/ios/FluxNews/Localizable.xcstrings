    "Local state rebuilt.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokaler Zustand wurde neu aufgebaut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado local reconstruido."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado local reconstruído."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale status opnieuw opgebouwd."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்ளூர் நிலை மீண்டும் உருவாக்கப்பட்டது."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
