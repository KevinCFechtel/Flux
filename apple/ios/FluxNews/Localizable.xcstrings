    "Choose the actions shown on the article list. More is always available for secondary actions.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle die Aktionen aus, die in der Artikelliste angezeigt werden. Weitere Aktionen bleiben immer verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the actions shown on the article list. More is always available for secondary actions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige las acciones que se muestran en la lista de artículos. Más siempre está disponible para las acciones secundarias."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolle as accións que se mostran na lista de artigos. Máis está sempre dispoñible para as accións secundarias."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de acties die in de artikellijst worden getoond. Meer blijft altijd beschikbaar voor secundaire acties."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "கட்டுரை பட்டியலில் காட்ட வேண்டிய செயல்களை தேர்வு செய்க. இரண்டாம் நிலை செயல்களுக்கு மேலும் எப்போதும் கிடைக்கும்."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Makale listesinde gösterilecek eylemleri seçin. İkincil eylemler için Daha Fazla her zaman kullanılabilir."
          }
        }
      }
    },
