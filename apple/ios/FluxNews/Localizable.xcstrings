          }
        }
      }
    },
    "Local state was cleared, but synchronization could not be completed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der lokale Zustand wurde gelöscht, aber die Synchronisierung konnte nicht abgeschlossen werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borró el estado local, pero no se pudo completar la sincronización."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpouse o estado local, pero non se puido completar a sincronización."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lokale status is gewist, maar de synchronisatie kon niet worden voltooid."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "உள்ளூர் நிலை அழிக்கப்பட்டது, ஆனால் ஒத்திசைவை முடிக்க முடியவில்லை."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel durum temizlendi ancak eşitleme tamamlanamadı."
          }
        }
      }
    },
    "Rebuild discards synchronized local data and downloads it again from Miniflux while keeping this account and your settings. Remove Account also removes account-bound data and credentials.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neu aufbauen verwirft synchronisierte lokale Daten und lädt sie erneut von Miniflux, während dieser Account und deine Einstellungen erhalten bleiben. Account entfernen löscht zusätzlich accountgebundene Daten und Zugangsdaten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconstruir descarta los datos locales sincronizados y los vuelve a descargar desde Miniflux, conservando esta cuenta y tus ajustes. Eliminar cuenta también elimina los datos y credenciales asociados a la cuenta."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconstruír descarta os datos locais sincronizados e volve descargalos de Miniflux, conservando esta conta e os teus axustes. Eliminar conta tamén elimina os datos e credenciais asociados á conta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnieuw opbouwen verwijdert gesynchroniseerde lokale gegevens en downloadt ze opnieuw van Miniflux, terwijl dit account en je instellingen behouden blijven. Account verwijderen wist ook accountgebonden gegevens en inloggegevens."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "மீண்டும் உருவாக்குதல் ஒத்திசைக்கப்பட்ட உள்ளூர் தரவை நீக்கி Miniflux இலிருந்து மீண்டும் பதிவிறக்கும்; இந்த கணக்கும் உங்கள் அமைப்புகளும் பாதுகாக்கப்படும். கணக்கை நீக்குவது கணக்கு சார்ந்த தரவையும் சான்றுகளையும் நீக்கும்."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden oluşturma, eşitlenmiş yerel verileri siler ve bu hesabı ve ayarlarınızı koruyarak Miniflux'tan yeniden indirir. Hesabı Kaldır ayrıca hesaba bağlı verileri ve kimlik bilgilerini de kaldırır."
          }
        }
      }
    },
    "Rebuild Local State?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalen Zustand neu aufbauen?"
