    "FluxNews notification permission is disabled. Enable notifications in iOS Settings to use System Notifications.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mitteilungsberechtigung für FluxNews ist deaktiviert. Aktivieren Sie Mitteilungen in den iOS-Einstellungen, um Systemmitteilungen zu verwenden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El permiso de notificaciones de FluxNews está desactivado. Activa las notificaciones en Ajustes de iOS para usar las notificaciones del sistema."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "O permiso de notificacións de FluxNews está desactivado. Activa as notificacións nos Axustes de iOS para usar as notificacións do sistema."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De meldingsmachtiging voor FluxNews is uitgeschakeld. Schakel meldingen in via iOS-instellingen om systeemmeldingen te gebruiken."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "FluxNews அறிவிப்பு அனுமதி முடக்கப்பட்டுள்ளது. கணினி அறிவிப்புகளை பயன்படுத்த iOS அமைப்புகளில் அறிவிப்புகளை இயக்கவும்."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "FluxNews bildirim izni kapalı. Sistem bildirimlerini kullanmak için iOS Ayarları'nda bildirimleri etkinleştirin."
          }
        }
      }
    },
