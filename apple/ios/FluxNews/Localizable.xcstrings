      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellung für die Hintergrundsynchronisierung konnte nicht geladen werden. Bitte versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo cargar la configuración de sincronización en segundo plano. Inténtalo de nuevo."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Non se puido cargar a configuración de sincronización en segundo plano. Téntao de novo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De instelling voor synchronisatie op de achtergrond kon niet worden geladen. Probeer het opnieuw."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பின்னணி ஒத்திசைவு அமைப்பை ஏற்ற முடியவில்லை. மீண்டும் முயற்சிக்கவும்."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka planda eşitleme ayarı yüklenemedi. Lütfen tekrar deneyin."
          }
        }
      }
    },
    "Background Sync setting could not be saved. Please try again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellung für die Hintergrundsynchronisierung konnte nicht gespeichert werden. Bitte versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la configuración de sincronización en segundo plano. Inténtalo de nuevo."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Non se puido gardar a configuración de sincronización en segundo plano. Téntao de novo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De instelling voor synchronisatie op de achtergrond kon niet worden opgeslagen. Probeer het opnieuw."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "பின்னணி ஒத்திசைவு அமைப்பை சேமிக்க முடியவில்லை. மீண்டும் முயற்சிக்கவும்."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arka planda eşitleme ayarı kaydedilemedi. Lütfen tekrar deneyin."
          }
        }
      }
    },
    "When enabled, FluxNews may refresh news in the background and when you return to the app. Manual Sync remains available at all times.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, kann FluxNews Nachrichten im Hintergrund und bei der Rückkehr zur App aktualisieren. Die manuelle Synchronisierung bleibt jederzeit verfügbar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando está activado, FluxNews puede actualizar las noticias en segundo plano y al volver a la app. La sincronización manual siempre está disponible."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cando está activado, FluxNews pode actualizar as novas en segundo plano e ao volver á aplicación. A sincronización manual está sempre dispoñible."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer ingeschakeld kan FluxNews nieuws op de achtergrond en bij terugkeer naar de app vernieuwen. Handmatige synchronisatie blijft altijd beschikbaar."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இயக்கப்பட்டிருக்கும்போது, FluxNews பின்னணியிலும் செயலிக்குத் திரும்பும்போதும் செய்திகளை புதுப்பிக்கலாம். கைமுறை ஒத்திசைவு எப்போதும் கிடைக்கும்."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinleştirildiğinde FluxNews haberleri arka planda ve uygulamaya döndüğünüzde yenileyebilir. Manuel eşitleme her zaman kullanılabilir."
          }
        }
      }
    },
