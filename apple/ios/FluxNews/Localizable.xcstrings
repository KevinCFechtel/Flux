    "Account data and feed preferences on this installation will be removed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Accountdaten und Feed-Einstellungen auf dieser Installation werden entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán los datos de la cuenta y las preferencias de feeds de esta instalación."
          }
        },
        "gl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminaranse os datos da conta e as preferencias das fontes desta instalación."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Accountgegevens en feedvoorkeuren op deze installatie worden verwijderd."
          }
        },
        "ta": {
          "stringUnit": {
            "state": "translated",
            "value": "இந்த நிறுவலில் உள்ள கணக்கு தரவும் ஃபீட் விருப்பங்களும் நீக்கப்படும்."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kurulumdaki hesap verileri ve akış tercihleri kaldırılacak."
          }
        }
      }
    },
