    "Automatic and manual downloads use the same network policy. Retention only removes media that is no longer protected by playback or other Core media state.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für automatische und manuelle Downloads gelten dieselben Netzwerkeinstellungen. Die Aufbewahrungsregel entfernt nur Medien, die nicht mehr durch Wiedergabe oder andere Core-Medienzustände geschützt sind."
          }
        }
      }
    },
