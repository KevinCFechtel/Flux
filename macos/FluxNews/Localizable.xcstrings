    "Discard synchronized local content. Miniflux becomes authoritative again; FluxNews and Feed Settings are preserved. Unsynchronized Read or Star changes may be lost.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisierte lokale Inhalte werden verworfen. Miniflux ist anschließend wieder maßgeblich; FluxNews und Feed-Einstellungen bleiben erhalten. Nicht synchronisierte Änderungen an Gelesen oder Markiert können verloren gehen."
          }
        }
      }
    },
