# Generated by Cargo
# will have compiled files and executables
debug
target
core/target/
tmp/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# env file
*.env
.codex-context/

# Editor/IDE
# .idea/
# .vscode/
.DS_Store
*.log
*.env.*
!*.env.example
*.p8
*.p12
*.pem
*.key
dist/
.build/
apple/macos/FluxNews/Generated/
apple/macos/Build/SwiftExplicitPrecompiledModules/
apple/macos/Build/XCBuildData/
apple/macos/Build/Debug
apple/macos/Build/EagerLinkingTBDs
apple/macos/Build/ExplicitPrecompiledModules
apple/macos/Build/FluxNews.build
apple/Build/Products/
apple/ios/FluxNews.xcodeproj/project.xcworkspace/xcuserdata/

# Android build and local environment files
android/.gradle/
android/.idea/
android/build/
android/app/build/
android/baselineprofile/build/
android/local.properties
android/migration-signing.properties
android/developmentBundle-signing.properties
android/captures/
android/**/*.apk
android/**/*.aab

# Keep canonical Android workflows despite case-insensitive filesystems.
!android/Build/
!android/Build/*.sh
android/Build/Products/
android/Build/reports/
